{
  "name": "@knowttl/ssh-axi",
  "version": "0.1.0",
  "description": "Discover approved SSH hosts and execute confirmed bounded commands",
  "type": "module",
  "bin": { "ssh-axi": "dist/main.js" },
  "files": ["dist", "axi-credential.schema.json", "artium-invocations.json", "README.md"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=24.11.0" },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "tsc",
    "inventory:write": "node scripts/inventory.ts --write",
    "lint": "tsc -p tsconfig.check.json && node scripts/inventory.ts",
    "test": "pnpm build && node scripts/test.ts",
    "verify:journey": "pnpm build && node scripts/journey.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@toon-format/toon": "2.3.1",
    "ssh2": "1.17.0",
    "ajv": "8.17.1",
    "axi-sdk-js": "0.1.13"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/ssh2": "1.15.5",
    "typescript": "5.9.3"
  }
}
