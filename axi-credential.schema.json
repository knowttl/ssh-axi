{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SSH profile",
  "x-protocol-revision": 1,
  "x-commands": {
    "": { "arguments": 0, "description": "Discover configured SSH hosts" },
    "host list": { "arguments": 0, "description": "List approved hosts without opening a transport" },
    "host show": { "arguments": 1, "description": "Show one approved host without opening a transport" },
    "doctor": { "arguments": 1, "description": "Authenticate to one host without executing a remote command" },
    "auth status": { "arguments": 0, "description": "Inspect selected credential sources offline" },
    "profile list": { "arguments": 0, "description": "List configured profiles offline" },
    "config path": { "arguments": 0, "description": "Show the configuration path offline" }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["address", "port", "username", "approvedHostKeys", "allowedAddresses"],
  "properties": {
    "address": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9.:_-]+$" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "username": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$" },
    "approvedHostKeys": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,2}$" } },
    "allowedAddresses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
    "privateKey": { "$ref": "#/definitions/secretRef", "x-secret": true },
    "passphrase": { "$ref": "#/definitions/secretRef", "x-secret": true }
  },
  "definitions": {
    "secretRef": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["env"], "properties": { "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } } },
        { "type": "object", "additionalProperties": false, "required": ["file"], "properties": { "file": { "type": "string", "minLength": 1 } } }
      ]
    }
  }
}
