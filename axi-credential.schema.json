{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SSH profile",
  "x-protocol-revision": 1,
  "x-connection-protocol-revision": 2,
  "x-commands": {
    "": { "arguments": 0, "description": "Discover configured SSH hosts" },
    "host list": { "arguments": 0, "description": "List approved hosts without opening a transport" },
    "host show": { "arguments": 1, "description": "Show one approved host without opening a transport" },
    "doctor": { "arguments": 1, "description": "Authenticate to one host without executing a remote command" },
    "auth status": { "arguments": 0, "description": "Inspect selected credential sources offline" },
    "profile list": { "arguments": 0, "description": "List configured profiles offline" },
    "config path": { "arguments": 0, "description": "Show the configuration path offline" },
    "exec": { "arguments": 1, "description": "Execute one confirmed arbitrary command", "flags": { "command": "string", "confirm": "boolean", "timeout": "string", "output-limit": "string", "detach": "boolean", "request-key": "string", "sudo": "boolean", "connection": "string" } },
    "connection open": { "arguments": 1, "description": "Open a private hosted connection", "flags": { "idle-timeout": "string", "sudo": "boolean" } },
    "connection list": { "arguments": 0, "description": "List caller-owned hosted connections" },
    "connection show": { "arguments": 1, "description": "Show a caller-owned hosted connection" },
    "connection set": { "arguments": 1, "description": "Change a hosted connection idle timeout", "flags": { "idle-timeout": "string" } },
    "connection close": { "arguments": 1, "description": "Close a caller-owned hosted connection", "flags": { "confirm": "boolean" } },
    "execution list": { "arguments": 0, "description": "List caller-owned executions" },
    "execution show": { "arguments": 1, "description": "Recover an execution without replay", "flags": { "request-key": "string", "full": "boolean" } },
    "execution cancel": { "arguments": 1, "description": "Cancel one caller-owned execution", "flags": { "confirm": "boolean" } }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["address", "port", "username", "approvedHostKeys", "allowedAddresses"],
  "properties": {
    "address": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9.:_-]+$", "description": "Approved SSH hostname or IP address; every resolved address must be allowed." },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535, "description": "Approved SSH TCP port." },
    "username": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$", "description": "Ordinary SSH account selected by the host binding." },
    "approvedHostKeys": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "description": "Independently verified server public keys, each as algorithm plus base64 key; at most two overlap during rotation.", "items": { "type": "string", "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,2}$" } },
    "allowedAddresses": { "type": "array", "minItems": 1, "uniqueItems": true, "description": "Approved literal IPv4 or IPv6 addresses; DNS cannot expand this set.", "items": { "type": "string", "minLength": 2 } },
    "privateKey": { "$ref": "#/definitions/secretRef", "x-secret": true },
    "passphrase": { "$ref": "#/definitions/secretRef", "x-secret": true }
  },
  "definitions": {
    "secretRef": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["env"], "properties": { "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } } },
        { "type": "object", "additionalProperties": false, "required": ["file"], "properties": { "file": { "type": "string", "minLength": 1 } } }
      ]
    }
  }
}
